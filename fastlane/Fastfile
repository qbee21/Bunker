default_platform(:ios)

platform :ios do
  desc "Archive the Unity Xcode export and create an IPA without uploading it"
  lane :build_ipa do
    setup_ci

    project_path = ENV.fetch("IOS_XCODE_PROJECT")
    export_path = ENV.fetch("IOS_EXPORT_PATH")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    bundle_id = ENV.fetch("IOS_BUNDLE_ID", "com.bunkerNoads.starodymov")
    profile_name = ENV.fetch("IOS_PROFILE_NAME")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      targets: ["Unity-iPhone"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: project_path,
      scheme: "Unity-iPhone",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: { bundle_id => profile_name },
        signingStyle: "manual",
        signingCertificate: "Apple Distribution"
      },
      archive_path: File.join(export_path, "BunkerEvolution.xcarchive"),
      output_directory: export_path,
      output_name: "BunkerEvolution.ipa"
    )
  end
end
